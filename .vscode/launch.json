{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Game in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev server"
    },
    {
      "name": "Game in Chrome (seed=1)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/?seed=1",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev server"
    },
    {
      "name": "Unit tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "console": "integratedTerminal"
    }
  ]
}
