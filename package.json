{
  "name": "bub-playables-pixi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bubble shooter playable built with PixiJS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "assets:build": "tsx tools/assets/build.ts",
    "size": "tsx tools/size/check.ts",
    "verify": "npm run assets:build && npm run lint && npm run typecheck && npm run coverage && npm run build && npm run size && npm run e2e"
  },
  "dependencies": {
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "maxrects-packer": "2.7.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  },
  "license": "UNLICENSED"
}
